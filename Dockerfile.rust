# Derived from the digest-pinned toolchain in docker-compose.yml.
#
# The base image ships rustc and cargo but not rustfmt or clippy, and its
# RUSTUP_HOME (/usr/local/rustup) is root-owned while the service runs as the
# host user — so `rustup component add` at container runtime cannot work. The
# components are added here instead, at build time, as root.
#
# The pin still lives in exactly one place: RUST_IMAGE is passed from the
# *rust_image anchor, so this file cannot name a different toolchain than the
# one docker-compose.yml pins.
ARG RUST_IMAGE
FROM ${RUST_IMAGE}

RUN rustup component add rustfmt clippy llvm-tools-preview \
    && chmod -R a+rX /usr/local/rustup /usr/local/cargo

# The cargo caches live in named volumes, and a named volume inherits the
# permissions of the image directory it is mounted over. Creating them here,
# world-writable, is what lets the container run as the host user and still
# write them.
#
# Everything else fails: a fresh named volume with no image directory behind it
# is created root-owned; a host bind mount is created root-owned by the daemon
# when it does not exist; and requiring an env var for the path made every
# `docker compose` command in the repository fail, including ones that only
# touch the Python builder.
RUN mkdir -p /cargo /target && chmod 1777 /cargo /target
