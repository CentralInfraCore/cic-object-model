---
# .yamllint configuration
# See https://yamllint.readthedocs.io/en/stable/configuration.html

extends: default

rules:
  # Increase the line-length limit to a more reasonable value for modern displays.
  line-length:
    max: 140
    level: warning  # Set to 'warning' instead of 'error' to be less strict.

  # GitHub Actions uses 'on' as a valid key, which is a truthy value.
  truthy:
    allowed-values: ['true', 'false', 'on']

# Override rules for specific file paths
file-rules:
  .github/workflows/*.yml:
    document-start:
      present: false  # GitHub Actions workflows don't require the document start marker.

ignore: |
  /p_venv/
  # KB companion YAMLs sit beside every Python source file (module: + objects:)
  # and are machine-generated. They are data, not hand-authored config, and the
  # generator emits sequences at column 0, which yamllint's default indentation
  # rule rejects. Linting generated output means either reformatting it by hand
  # after every regeneration, or changing a rule that applies to files people do
  # write. CIC-Relay settled this the same way, for the same reason.
  #
  # Deliberately NOT ignored here: /spec/. Those schemas are the normative
  # artefact of this repository and are hand-authored — CIC-Relay's blanket
  # `*.schema.yaml` ignore would have swallowed them.
  /tools/
  /tests/
  # Same generator, same reason: companion metadata sits beside every Go source
  # file too, once an implementation exists.
  /go/
